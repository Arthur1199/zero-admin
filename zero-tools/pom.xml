<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zero</groupId>
        <artifactId>zero</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zero-tools</artifactId>
    <packaging>jar</packaging>
    <name>zero-tools</name>
    <description>zero基础工具包</description>

    <properties>
        <tools.commons-lang3.version>3.20.0</tools.commons-lang3.version>
        <tools.commons-io.version>2.22.0</tools.commons-io.version>
        <tools.jakarta-mail.version>2.0.2</tools.jakarta-mail.version>
        <tools.dom4j.version>2.2.0</tools.dom4j.version>
        <tools.jsoup.version>1.22.2</tools.jsoup.version>
        <tools.fastjson2.version>2.0.62</tools.fastjson2.version>
        <tools.jackson.version>2.21.3</tools.jackson.version>
        <tools.jackson-annotations.version>2.21</tools.jackson-annotations.version>
        <tools.zxing.version>3.5.4</tools.zxing.version>
        <tools.java-jwt.version>4.5.2</tools.java-jwt.version>
        <tools.hutool.version>5.8.44</tools.hutool.version>
        <tools.spring.version>6.2.18</tools.spring.version>
        <tools.slf4j.version>2.0.18</tools.slf4j.version>
        <tools.servlet.version>6.1.0</tools.servlet.version>
        <tools.libphonenumber.version>9.0.30</tools.libphonenumber.version>
        <tools.selenium.version>4.44.0</tools.selenium.version>
        <tools.opentelemetry.version>1.62.0</tools.opentelemetry.version>
        <tools.opentelemetry-alpha.version>1.62.0-alpha</tools.opentelemetry-alpha.version>
        <tools.byte-buddy.version>1.18.8-jdk5</tools.byte-buddy.version>
        <selenium.version>${tools.selenium.version}</selenium.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 覆盖java-jwt传递的旧Jackson版本，不作为工具包直接API暴露。 -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${tools.jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${tools.jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${tools.jackson-annotations.version}</version>
            </dependency>

            <!-- Selenium 4.44.0依赖较新的OpenTelemetry，避免被父工程Spring Boot依赖管理压低版本。 -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${tools.opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom-alpha</artifactId>
                <version>${tools.opentelemetry-alpha.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${tools.byte-buddy.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Apache Commons基础工具：字符串、IO。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${tools.commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${tools.commons-io.version}</version>
        </dependency>

        <!-- 邮件发送：MailHelper直接使用Jakarta Mail 2.x，避免旧版Commons Email传递依赖风险。 -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>${tools.jakarta-mail.version}</version>
        </dependency>
        <dependency>
            <groupId>com.sun.activation</groupId>
            <artifactId>jakarta.activation</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- XML/HTML解析：XMLHelper、HtmlParse、JsoupHelper、DomainCheckUtil使用。 -->
        <dependency>
            <groupId>org.dom4j</groupId>
            <artifactId>dom4j</artifactId>
            <version>${tools.dom4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${tools.jsoup.version}</version>
        </dependency>

        <!-- JSON工具：统一使用fastjson2，避免继续依赖fastjson 1.x兼容包。 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${tools.fastjson2.version}</version>
        </dependency>
        <!-- Servlet API：仅编译期使用，运行期由Web容器或Spring Boot提供。 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${tools.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 二维码与认证安全工具：谷歌动态码二维码、JWT签名解析。 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${tools.zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${tools.zxing.version}</version>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${tools.java-jwt.version}</version>
        </dependency>

        <!-- hutool：Bean复制和通用工具能力。 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${tools.hutool.version}</version>
        </dependency>

        <!-- Spring与日志基础依赖：工具类直接使用spring-core、spring-beans和slf4j-api。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${tools.slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <version>${tools.spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
            <version>${tools.spring.version}</version>
        </dependency>

        <!-- 手机号码解析与格式校验。 -->
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>${tools.libphonenumber.version}</version>
        </dependency>

        <!-- 浏览器自动化：DomainCheckUtil使用ChromeDriver访问并解析动态网页。 -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-api</artifactId>
            <version>${tools.selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-chromium-driver</artifactId>
            <version>${tools.selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-chrome-driver</artifactId>
            <version>${tools.selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>${tools.selenium.version}</version>
        </dependency>
    </dependencies>
</project>
