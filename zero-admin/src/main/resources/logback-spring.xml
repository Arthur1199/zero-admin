<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 应用名称来自spring.application.name，避免Nacos中的中文展示名导致日志目录重复生成 -->
    <springProperty scope="context" name="app.name" source="spring.application.name" defaultValue="zero-admin"/>
    <!-- 业务包名来自 PackageProperties 启动前写入的系统属性，避免重命名后遗漏日志配置 -->
    <springProperty scope="context" name="package.name" source="zero.package.base-package" defaultValue="com.zero"/>
    <!-- 日志存放路径：相对于应用启动目录，目录名随应用名称自动变化 -->
    <property name="log.path" value="logs/${app.name}"/>
    <!-- 日志输出格式 -->
    <property name="log.pattern" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{20} - [%method,%line] - %msg%n"/>
    <!-- 单个日志文件最大容量 -->
    <property name="log.maxFileSize" value="200MB"/>
    <!-- 日志保留天数 -->
    <property name="log.maxHistory" value="60"/>

    <!-- 实时查看内存上限，可由环境变量或启动配置覆盖，不改变原文件日志。 -->
    <springProperty scope="context" name="realtime.maxEvents" source="zero.realtime-log.max-events" defaultValue="5000"/>
    <springProperty scope="context" name="realtime.maxBytes" source="zero.realtime-log.max-bytes" defaultValue="10485760"/>
    <springProperty scope="context" name="realtime.maxEventBytes" source="zero.realtime-log.max-event-bytes" defaultValue="65536"/>
    <!-- 完整控制台模式只读启动器或IDEA保存的进程输出文件，覆盖JVM原生输出。 -->
    <springProperty scope="context" name="realtime.consoleFile" source="zero.realtime-log.console-file" defaultValue=""/>
    <springProperty scope="context" name="realtime.consoleCharset" source="zero.realtime-log.console-charset" defaultValue="UTF-8"/>
    <appender name="realtime" class="com.zero.framework.realtimelog.RealtimeLogAppender">
        <pattern>${log.pattern}</pattern>
        <maxEvents>${realtime.maxEvents}</maxEvents>
        <maxBytes>${realtime.maxBytes}</maxBytes>
        <maxEventBytes>${realtime.maxEventBytes}</maxEventBytes>
        <consoleFile>${realtime.consoleFile}</consoleFile>
        <consoleCharset>${realtime.consoleCharset}</consoleCharset>
    </appender>

    <!-- 控制台输出，方便本地开发和容器控制台采集 -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>

    <!-- 系统普通运行日志，只记录 INFO 级别，按日期目录和文件大小滚动 -->
    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/info/%d{yyyy-MM-dd}/sys-info.%i.log</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 系统异常日志，只记录 ERROR 级别，便于快速排查线上问题 -->
    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/error/%d{yyyy-MM-dd}/sys-error.%i.log</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 用户访问和操作日志，独立存放避免和系统运行日志混在一起 -->
    <appender name="sys-user" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/sys-user.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/user/%d{yyyy-MM-dd}/sys-user.%i.log</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>

    <!-- 系统模块日志级别控制 -->
    <logger name="${package.name}" level="info"/>
    <!-- Spring 日志级别控制，减少框架噪音日志 -->
    <logger name="org.springframework" level="warn"/>

    <!-- 系统用户操作日志，关闭向上追加，避免重复写入 root 日志 -->
    <logger name="sys-user" level="info" additivity="false">
        <appender-ref ref="sys-user"/>
    </logger>

    <root level="info">
        <appender-ref ref="console"/>
        <appender-ref ref="realtime"/>
        <appender-ref ref="file_info"/>
        <appender-ref ref="file_error"/>
    </root>
</configuration>
