<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zero.system.mapper.SysIpWhiteMapper">

    <resultMap type="SysIpWhite" id="SysIpWhiteResult">
        <id     property="id"          column="id"          />
        <result property="ipAddr"      column="ip_addr"     />
        <result property="ipRegion"    column="ip_region"   />
        <result property="status"      column="status"      />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>

    <sql id="selectIpWhiteVo">
        select id, ip_addr, ip_region, status, create_by, create_time, update_by, update_time, remark
        from sys_ip_white
    </sql>

    <select id="selectIpWhiteById" parameterType="Long" resultMap="SysIpWhiteResult">
        <include refid="selectIpWhiteVo"/>
        where id = #{id}
    </select>

    <select id="selectIpWhiteByIpAddr" parameterType="String" resultMap="SysIpWhiteResult">
        <include refid="selectIpWhiteVo"/>
        where ip_addr = #{ipAddr} limit 1
    </select>

    <select id="selectIpWhiteList" parameterType="SysIpWhite" resultMap="SysIpWhiteResult">
        <include refid="selectIpWhiteVo"/>
        <where>
            <if test="ipAddr != null and ipAddr != ''">
                AND ip_addr like concat('%', #{ipAddr}, '%')
            </if>
            <if test="ipRegion != null and ipRegion != ''">
                AND ip_region like concat('%', #{ipRegion}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc, id desc
    </select>

    <select id="selectEnabledIpAddrs" resultType="String">
        select ip_addr
        from sys_ip_white
        where status = '1'
    </select>

    <insert id="insertIpWhite" parameterType="SysIpWhite" useGeneratedKeys="true" keyProperty="id">
        insert into sys_ip_white (
            ip_addr,
            ip_region,
            status,
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            #{ipAddr},
            #{ipRegion},
            #{status},
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateIpWhite" parameterType="SysIpWhite">
        update sys_ip_white
        <set>
            <if test="ipRegion != null">ip_region = #{ipRegion},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteIpWhiteById" parameterType="Long">
        delete from sys_ip_white where id = #{id}
    </delete>

    <delete id="deleteIpWhiteByIds" parameterType="Long">
        delete from sys_ip_white where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
