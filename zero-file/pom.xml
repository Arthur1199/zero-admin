<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zero</groupId>
        <artifactId>zero</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zero-file</artifactId>
    <packaging>jar</packaging>
    <description>zero file service</description>

    <properties>
        <!-- 存储 SDK 共用一套 OkHttp、Okio 和 Kotlin 运行时，避免在同一个进程中加载不同代的类。 -->
        <okhttp.version>5.5.1</okhttp.version>
        <okio.version>3.18.1</okio.version>
        <kotlin.version>2.1.21</kotlin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 导入 OkHttp 版本清单，统一 MinIO、华为云 OBS 等存储 SDK 的 HTTP 客户端版本。 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-bom</artifactId>
                <version>${okhttp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 导入 Okio 版本清单，统一 OkHttp 使用的缓冲区和流读写组件版本。 -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-bom</artifactId>
                <version>${okio.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 管理阿里云 OSS SDK 引入的 Jettison 版本，提供 JSON 与 StAX 接口之间的适配。 -->
            <dependency>
                <groupId>org.codehaus.jettison</groupId>
                <artifactId>jettison</artifactId>
                <version>1.5.7</version>
            </dependency>
            <!-- 将华为云 OBS SDK 引入的 Log4j Core 对齐到父 POM 管理的安全修复版本。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j2.version}</version>
            </dependency>
            <!-- 管理 MinIO SDK 引入的 Snappy 压缩库版本，使用同系列的安全修复版本。 -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 提供文件服务在本地开发期的应用自动重启，并标记为可选依赖。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- 复用统一响应对象和通用工具，供文件服务的接口与文件操作使用。 -->
        <dependency>
            <groupId>com.zero</groupId>
            <artifactId>zero-tools</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 在文件服务启动早期加载外部配置，供数据源和存储平台初始化使用。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- 将文件服务注册到 Nacos，供管理后台按服务名调用。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 从 Nacos 加载文件服务的外部配置。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 提供声明式 HTTP 客户端支持，由文件服务启动类启用 Feign 客户端扫描。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- 给按服务名发起的客户端请求提供实例选择和负载均衡。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 提供健康检查等运行状态端点，供监控服务读取。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 引入 Spring MVC 和内嵌 Tomcat，承载文件上传、下载和管理接口。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- 提供 Jakarta Bean Validation 支持，用于校验文件查询与管理接口的参数。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 在编译期为 FileStorageProperties 生成配置元数据，供 IDEA 提示存储配置项。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 提供文件记录所在 MySQL 数据源的 JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- 提供适配 Spring Boot 4 的 Druid 连接池，供文件记录持久化使用。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-4-starter</artifactId>
        </dependency>
        <!-- 集成 MyBatis-Plus 的 Mapper 与通用 CRUD，用于文件记录持久化。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 为 MyBatis-Plus 分页拦截器提供 SQL 解析能力，供文件列表分页使用。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- 提供动态数据源配置和路由，文件记录默认使用 zeroBiz 数据源。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 提供字符串与对象等基础工具方法。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <!-- 提供流读写、文件名处理等文件操作工具。 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>
        <!-- 提供字符串、文件名、集合与流操作，供文件上传预处理及多个存储适配器使用。 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>5.8.44</version>
        </dependency>
        <!-- 用来缩放原图和生成缩略图。 -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.13</version>
        </dependency>

        <!-- 为 AwsS3FileStorage 提供 Amazon S3 SDK，负责对象上传、下载和删除。 -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-s3</artifactId>
            <version>1.12.797</version>
        </dependency>
        <!-- 为 MinIOFileStorage 提供 MinIO 对象客户端，支持原文件和缩略图的存取。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>
        <!-- 为 AliyunOssFileStorage 提供阿里云 OSS 对象存储客户端。 -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.5</version>
        </dependency>
        <!-- 为 TencentCosFileStorage 提供腾讯云 COS 静态密钥认证和对象操作接口。 -->
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
            <version>5.6.283</version>
            <exclusions>
                <!-- COS 使用显式密钥，无需腾讯云 SDK 的本地 INI 凭据读取器。 -->
                <exclusion>
                    <groupId>org.ini4j</groupId>
                    <artifactId>ini4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 为 QiniuKodoFileStorage 提供七牛云 Kodo 的上传凭证和对象管理接口。 -->
        <dependency>
            <groupId>com.qiniu</groupId>
            <artifactId>qiniu-java-sdk</artifactId>
            <version>7.19.0</version>
        </dependency>
        <!-- 为 BaiduBosFileStorage 提供百度智能云 BOS 对象存储接口。 -->
        <dependency>
            <groupId>com.baidubce</groupId>
            <artifactId>bce-java-sdk</artifactId>
            <version>0.10.450</version>
            <exclusions>
                <!-- 文件服务只调用 BOS，HBase、Hadoop 和 IoT 的旧 HTTP 栈由 SDK 的其他服务使用。 -->
                <exclusion>
                    <groupId>org.apache.hbase</groupId>
                    <artifactId>hbase-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>hadoop-mapreduce-client-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-httpclient</groupId>
                    <artifactId>commons-httpclient</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk15on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jdk.tools</groupId>
                    <artifactId>jdk.tools</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 为 HuaweiObsFileStorage 提供华为云 OBS 对象存储接口。 -->
        <dependency>
            <groupId>com.huaweicloud</groupId>
            <artifactId>esdk-obs-java</artifactId>
            <version>3.26.9</version>
        </dependency>
        <!-- 为 UpyunUssFileStorage 提供又拍云 USS 文件操作接口。 -->
        <dependency>
            <groupId>com.upyun</groupId>
            <artifactId>java-sdk</artifactId>
            <version>4.2.3</version>
        </dependency>
        <!-- 又拍云 SDK 仍请求旧版 JSON-java，显式使用已修复版本。 -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20260814</version>
        </dependency>
        <!-- 提供 Jakarta XML Binding 的运行时实现，支持存储依赖所需的 XML 转换。 -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- 在编译期为存储适配器和配置类生成访问方法、链式调用或日志字段，并标记为可选依赖。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 引入测试作用域的 JUnit、Mockito 和 Spring Test，供文件服务测试使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
