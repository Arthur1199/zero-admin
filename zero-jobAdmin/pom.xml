<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zero</groupId>
        <artifactId>zero</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>zero-jobAdmin</artifactId>
    <description>基于XXL-JOB的独立调度中心</description>
    <properties>
        <xxl-job.version>3.5.0</xxl-job.version>
        <xxl-sso.version>2.4.1</xxl-sso.version>
        <xxl-tool.version>2.5.2</xxl-tool.version>
        <job.mybatis-starter.version>3.0.5</job.mybatis-starter.version>
        <!-- 即使先编译过集成用例，普通打包也不能执行其外部写操作。 -->
        <job.test.excluded-groups>job-integration</job.test.excluded-groups>
    </properties>
    <dependencies>
        <!-- 提供调度中心在本地开发期的应用自动重启，并标记为可选依赖。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- 在编译期为调度中心的启动类和业务组件生成 SLF4J 日志字段，版本由父 POM 管理。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 引入 Spring MVC 和内嵌 Tomcat，承载调度控制台和执行器通信接口。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 提供 FreeMarker 模板引擎，渲染调度中心登录页和任务管理页面。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-freemarker</artifactId>
        </dependency>
        <!-- 装配 JavaMailSender，供任务失败时按配置发送告警邮件。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- 提供健康检查等运行状态端点，供 Boot Admin 监控调度中心。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 集成调度中心的 Mapper 与 XML SQL，沿用 Spring Boot 3 适配版本。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${job.mybatis-starter.version}</version>
        </dependency>
        <!-- 提供调度中心连接独立 zero_job 库所需的 MySQL JDBC 驱动。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- 提供调度中心与执行器通信使用的协议、请求对象和调度常量。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
            <version>${xxl-job.version}</version>
        </dependency>
        <!-- 为调度控制台提供登录拦截、会话模型和独立认证支持。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-sso-core</artifactId>
            <version>${xxl-sso.version}</version>
        </dependency>
        <!-- 提供 XXL-JOB 使用的响应模型、分页对象及字符串、日期和 JSON 工具。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-tool</artifactId>
            <version>${xxl-tool.version}</version>
        </dependency>
        <!-- 在启动早期加载外部配置，使数据源及调度设置可在应用初始化时读取。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>
        <!-- 将调度中心注册到 Nacos，供监控服务发现实例。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 从 Nacos 读取调度中心的数据源、邮件和调度参数。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
            <exclusions>
                <!-- 配置中心传递带入旧Druid starter，调度库统一使用官方Hikari连接池。 -->
                <exclusion>
                    <groupId>com.alibaba</groupId>
                    <artifactId>druid-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 引入测试作用域的 JUnit、Mockito 和 Spring Test，供控制台、登录及调度协议回归使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${job.test.excluded-groups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.zero.ZeroJobAdminApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- 官方用例包含真实写库、调度和停止任务，只允许显式启用。 -->
        <profile>
            <id>job-integration</id>
            <properties>
                <!-- 显式profile允许运行官方用例；仅test-compile仍不会执行测试。 -->
                <job.test.excluded-groups>job-integration-disabled</job.test.excluded-groups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>official-integration-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources><source>src/integration-test/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
