<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.zero</groupId>
    <artifactId>zero</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>zero</name>
    <url>https://www.zero.vip</url>
    <description>zero parent project</description>

    <modules>
        <module>zero-tools</module>
        <module>zero-admin</module>
        <module>zero-bootAdmin</module>
        <module>zero-report</module>
        <module>zero-file</module>
        <module>zero-jobAdmin</module>
        <module>zero-task</module>
    </modules>

    <properties>
        <zero.version>3.9.0</zero.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
        <spring-cloud.version>2025.0.2</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
        <spring-cloud-bootstrap.version>4.3.2</spring-cloud-bootstrap.version>
        <spring-boot-admin.version>3.5.8</spring-boot-admin.version>
        <!-- 在 Jackson 2.21 系列内统一应用解析器安全修复，覆盖 java-jwt 的传递依赖。 -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <!-- 统一 Selenium 传递依赖的安全版本，确保工具包和使用方解析一致。 -->
        <opentelemetry.version>1.68.0</opentelemetry.version>
        <guava.version>33.8.0-jre</guava.version>
        <!-- 按组件系列统一采用公开的安全修复版本。 -->
        <!-- 统一内嵌 Tomcat 版本，供各 Servlet Web 服务承载 HTTP 请求。 -->
        <tomcat.version>10.1.62</tomcat.version>
        <!-- 统一 Netty 组件版本，供 Reactor Netty、Redisson 等网络客户端和服务端使用。 -->
        <netty.version>4.1.141.Final</netty.version>
        <!-- 统一 Apache HttpClient 5 的版本，供使用 5.x API 的 HTTP 客户端使用。 -->
        <httpclient5.version>5.6.5</httpclient5.version>
        <!-- 统一 Apache HttpCore 5 的版本，为 HttpClient 5 提供配套的 HTTP 协议实现。 -->
        <httpcore5.version>5.4.4</httpcore5.version>
        <!-- 统一 Commons Codec 的版本，提供 Base64、Hex 和摘要等工具。 -->
        <commons-codec.version>1.23.0</commons-codec.version>
        <!-- 统一 Log4j 2 组件版本，包括日志 API、桥接和文件服务使用的 Core。 -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- 统一 Logback 的日志实现版本，支持各服务控制台输出与日志文件滚动。 -->
        <logback.version>1.6.6</logback.version>
        <!-- 统一 SLF4J 日志接口版本，与服务采用的 Logback 实现配套。 -->
        <slf4j.version>2.0.19</slf4j.version>
        <!-- 统一 FreeMarker 模板引擎版本，供 XXL-JOB 调度中心渲染控制台。 -->
        <freemarker.version>2.3.35</freemarker.version>
        <thymeleaf.version>3.1.5.RELEASE</thymeleaf.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <druid-3.version>1.2.25</druid-3.version>
        <jaxb-runtime.version>4.0.4</jaxb-runtime.version>
        <bitwalker.version>1.21</bitwalker.version>
        <!-- Spring Boot 3.5 / Spring Framework 6.2使用兼容的SpringDoc 2.8系列。 -->
        <springdoc.version>2.8.17</springdoc.version>
        <mysql-connector.version>9.3.0</mysql-connector.version>
        <swagger.version>3.0.0</swagger.version>
        <kaptcha.version>2.3.3</kaptcha.version>
        <pagehelper.boot.version>2.0.0</pagehelper.boot.version>
        <report.pagehelper.boot.version>4.1.0</report.pagehelper.boot.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <dynamic-datasource.version>4.6.0</dynamic-datasource.version>
        <mybatis-spring.version>3.0.3</mybatis-spring.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <jakarta-servlet.version>6.0.0</jakarta-servlet.version>
        <fastjson.version>2.0.62</fastjson.version>
        <oshi.version>6.8.1</oshi.version>
        <commons.io.version>2.22.0</commons.io.version>
        <poi.version>5.4.1</poi.version>
        <velocity.version>2.3</velocity.version>
        <jwt.version>0.12.6</jwt.version>
        <zxing.version>3.5.4</zxing.version>
        <ip2region.version>2.7.0</ip2region.version>
        <httpclient.version>4.5.14</httpclient.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 对齐 Selenium 等依赖引入的 OpenTelemetry 遥测组件，包括仍使用 alpha 版本的模块。 -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom-alpha</artifactId>
                <version>${opentelemetry.version}-alpha</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 统一 Guava 版本，供 Selenium、MinIO 等传递依赖使用其集合、缓存和基础工具。 -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- 导入 Spring Cloud 版本清单，统一 OpenFeign、负载均衡等微服务组件的版本。 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 统一启动引导组件的版本，供接入 Nacos 的服务在应用启动早期读取外部配置。 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-bootstrap</artifactId>
                <version>${spring-cloud-bootstrap.version}</version>
            </dependency>
            <!-- 导入 Spring Cloud Alibaba 版本清单，管理 Nacos 配置和服务发现等组件。 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 统一 Spring Boot 3 适配版 Druid，供使用 Druid 的服务配置 JDBC 连接池。 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid-3.version}</version>
            </dependency>
            <!-- 统一 Spring MVC 接口文档和 Swagger UI 的版本，供管理后台生成和浏览 OpenAPI 文档。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- 统一 MySQL JDBC 驱动版本，供需要连接 MySQL 的 Java 服务使用。 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>
            <!-- 管理 PageHelper 的默认版本，供管理后台对列表 SQL 执行分页。 -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper.boot.version}</version>
            </dependency>
            <!-- 统一 MyBatis-Plus 的 Spring Boot 3 集成版本，供报表、文件和任务模块使用 Mapper 与通用 CRUD。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 与 MyBatis-Plus 主组件对齐，为分页拦截器提供 SQL 解析能力。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 统一 Spring Boot 3 动态数据源组件，供模块按业务库或管理库路由数据库连接。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>
            <!-- 管理 MyBatis 与 Spring 的集成层版本，提供 Mapper 注册和事务管理衔接。 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <!-- 管理字符串处理、对象比较等 Apache Commons Lang 工具的默认版本。 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <!-- 统一 Jakarta XML Binding 的运行时实现，满足 JDK 17 下 XML 对象绑定所需的运行时依赖。 -->
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
            </dependency>
            <!-- 管理 Jakarta Servlet 接口版本，供 Web 模块编译请求、响应、过滤器等代码。 -->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta-servlet.version}</version>
            </dependency>
            <!-- 统一监控服务端组件版本，通过 Actuator 收集和展示服务运行状态。 -->
            <dependency>
                <groupId>de.codecentric</groupId>
                <artifactId>spring-boot-admin-starter-server</artifactId>
                <version>${spring-boot-admin.version}</version>
            </dependency>
            <!-- 管理 Thymeleaf 模板引擎核心版本，供 Boot Admin 等页面渲染组件使用。 -->
            <dependency>
                <groupId>org.thymeleaf</groupId>
                <artifactId>thymeleaf</artifactId>
                <version>${thymeleaf.version}</version>
            </dependency>
            <!-- 管理 Thymeleaf 的 Spring 6 适配模块，使模板引擎与 Spring MVC 视图解析协同工作。 -->
            <dependency>
                <groupId>org.thymeleaf</groupId>
                <artifactId>thymeleaf-spring6</artifactId>
                <version>${thymeleaf.version}</version>
            </dependency>
            <!-- 管理 Apache HttpClient 4.x 版本，兼容 Boot Admin 机器人通知等使用旧 API 的代码。 -->
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpclient</artifactId>
                <version>${httpclient.version}</version>
            </dependency>
            <!-- 统一 Bouncy Castle 密码学提供者版本，供需要签名、加密等算法实现的依赖使用。 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- 统一 User-Agent 解析库版本，供管理后台识别浏览器和操作系统。 -->
            <dependency>
                <groupId>eu.bitwalker</groupId>
                <artifactId>UserAgentUtils</artifactId>
                <version>${bitwalker.version}</version>
            </dependency>
            <!-- 统一 OSHI 版本，供服务器监控读取 CPU、内存、磁盘和操作系统信息。 -->
            <dependency>
                <groupId>com.github.oshi</groupId>
                <artifactId>oshi-core</artifactId>
                <version>${oshi.version}</version>
            </dependency>
            <!-- 管理文件名、目录与输入输出流工具的默认版本。 -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons.io.version}</version>
            </dependency>
            <!-- 统一 Apache POI 的 Office Open XML 组件版本，供管理后台导入和导出 Excel 文件。 -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <!-- 管理 Velocity 模板引擎版本，供管理后台和各模块的代码生成器渲染模板。 -->
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>${velocity.version}</version>
            </dependency>
            <!-- 统一 Fastjson2 的默认版本，供 Java 对象和 JSON 之间转换。 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson.version}</version>
            </dependency>
            <!-- 统一 IP 离线查询库版本，供管理后台根据本地 XDB 数据查找 IP 归属地。 -->
            <dependency>
                <groupId>org.lionsoul</groupId>
                <artifactId>ip2region</artifactId>
                <version>${ip2region.version}</version>
            </dependency>
            <!-- 统一 JJWT 公共接口版本，供管理后台生成、解析和校验登录令牌。 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!-- 与 JJWT 接口版本对齐，提供令牌签名、解析和校验的运行时实现。 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!-- 与 JJWT 接口版本对齐，负责通过 Jackson 转换令牌头和声明中的 JSON 数据。 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!-- 统一验证码组件版本，供管理后台生成登录图片验证码。 -->
            <dependency>
                <groupId>pro.fessional</groupId>
                <artifactId>kaptcha</artifactId>
                <version>${kaptcha.version}</version>
            </dependency>
            <!-- 统一 ZXing 核心库版本，提供条码、二维码的编码和解码算法。 -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <!-- 统一 ZXing 的 Java SE 图像适配层版本，提供二维码图像的生成与读取。 -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>${maven-war-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>
</project>
